#!/bin/sh
set -e
# 0.1.0 shipped the template's /etc/template-app.conf, which every app from the
# template also ships; remove it (kept as .dpkg-bak if it was edited).
dpkg-maintscript-helper rm_conffile /etc/template-app.conf 0.1.1~ -- "$@"
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable updoit-check.timer >/dev/null 2>&1 || true
    systemctl start updoit-check.timer >/dev/null 2>&1 || true
fi
# Make sure the launcher icon exists even if counting fails, then produce a first count
# (and badge) right away from the current lists (no network needed).
live=/usr/share/APPLaunch/share/images/updoit-for-cardputer-zero-live.png
if [ ! -e "$live" ] && [ -d "$(dirname "$live")" ]; then
    cp -f /usr/share/updoit/icons/updoit-badge-0.png "$live" 2>/dev/null || true
fi
/usr/libexec/updoit/updoit-check --no-update >/dev/null 2>&1 || true
exit 0
