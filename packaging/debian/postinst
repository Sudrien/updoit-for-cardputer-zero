#!/bin/sh
set -e
# 0.1.0 shipped the template's /etc/template-app.conf, which every app from the
# template also ships; remove it (kept as .dpkg-bak if it was edited).
dpkg-maintscript-helper rm_conffile /etc/template-app.conf 0.1.1~ -- "$@"
# 0.2.1 moved the check settings under /etc/<package>/ (app store path rules).
dpkg-maintscript-helper mv_conffile /etc/updoit.conf /etc/updoit-for-cardputer-zero/updoit.conf 0.2.1~ -- "$@"
P=updoit-for-cardputer-zero
if [ "$1" = "configure" ]; then
    # Unprivileged service user for $P-check.service (store rule: no root
    # services). Created here because usr/lib/sysusers.d is not an allowed
    # store path. Idempotent: adduser --system succeeds if it already exists.
    if ! getent passwd "$P" >/dev/null; then
        adduser --system --group --quiet --home /nonexistent --no-create-home \
            --gecos "Updoit update check" "$P"
    fi
    # /var/lib/$P and launcher icon ownership come from the tmpfiles.d file.
    systemd-tmpfiles --create "$P.conf" >/dev/null 2>&1 || true
    # Status file from before 0.2.1
    if [ -f /etc/updoit.status ] && [ ! -e "/var/lib/$P/status" ]; then
        mv /etc/updoit.status "/var/lib/$P/status"
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable $P-check.timer >/dev/null 2>&1 || true
        systemctl start $P-check.timer >/dev/null 2>&1 || true
        # First count and badge now, as the service user (no network needed).
        systemctl start --no-block $P-check.service >/dev/null 2>&1 || true
    fi
fi
exit 0
