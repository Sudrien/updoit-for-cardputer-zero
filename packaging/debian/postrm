#!/bin/sh
set -e
# 0.1.0 shipped the template's /etc/template-app.conf, which every app from the
# template also ships; remove it (kept as .dpkg-bak if it was edited).
dpkg-maintscript-helper rm_conffile /etc/template-app.conf 0.1.1~ -- "$@"
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -rf /run/updoit /var/cache/updoit
    rm -f /etc/updoit.status
    rm -f /usr/share/APPLaunch/share/images/updoit-for-cardputer-zero-live.png
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi
exit 0
