#!/bin/sh
set -e
# 0.1.0 shipped the template's /etc/template-app.conf, which every app from the
# template also ships; remove it (kept as .dpkg-bak if it was edited).
dpkg-maintscript-helper rm_conffile /etc/template-app.conf 0.1.1~ -- "$@"
# 0.2.1 moved the check settings under /etc/<package>/ (app store path rules).
dpkg-maintscript-helper mv_conffile /etc/updoit.conf /etc/updoit-for-cardputer-zero/updoit.conf 0.2.1~ -- "$@"
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi
if [ "$1" = "purge" ]; then
    # Counts cache and root's aria2 download cache, under the package's own
    # state dir (not a home directory; the service user's home is /nonexistent).
    # Explicit files only, no recursive delete. The service user is left in
    # place, as Debian policy recommends. The launcher poke file is shipped in
    # the package, so dpkg removes it.
    STATE=/var/lib/updoit-for-cardputer-zero
    rm -f "$STATE/status" \
          "$STATE"/archives/*.deb "$STATE"/archives/*.aria2 \
          "$STATE"/archives/partial/*.deb "$STATE"/archives/partial/*.aria2
    rmdir "$STATE/archives/partial" "$STATE/archives" "$STATE" 2>/dev/null || true
fi
exit 0
